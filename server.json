{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.adelaidasofia/linear-mcp",
  "title": "Linear MCP (multi-workspace, PAT auth)",
  "description": "Multi-workspace Linear MCP — PAT auth, 57 tools + 3 prompts, drop-in for official MCP.",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/adelaidasofia/linear-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "adelaidasofia-linear-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LINEAR_PAT",
          "description": "Personal API Key from linear.app/settings/account/security",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/adelaidasofia/linear-mcp/releases/download/v0.2.0/linear-mcp.mcpb",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "fileSha256": "ee057ce5db8daf57e1bb464d23f7c72b83365f8a1599b1f92976e357019603af",
      "environmentVariables": [
        {
          "name": "LINEAR_PAT",
          "description": "Personal API Key from linear.app/settings/account/security",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
