# linear-mcp config — copy to admin.env and fill in.
# chmod 600 admin.env after saving.
#
# Generate Personal API Keys at linear.app/settings/account/security
# (one per workspace; you must be logged into each workspace separately).

# Comma-separated list of workspace aliases. Aliases are lowercase
# and used in tool calls as the `workspace` parameter. Pick whatever
# names help you route (personal/work, client-a/client-b, etc.).
LINEAR_WORKSPACES=personal,work

# Default workspace when a tool omits the `workspace` parameter.
LINEAR_PRIMARY_WORKSPACE=personal

# Per-workspace PATs. The suffix matches the alias, uppercased,
# with hyphens converted to underscores.
LINEAR_PAT_PERSONAL=lin_api_REPLACE_ME
LINEAR_PAT_WORK=lin_api_REPLACE_ME

# Optional friendly labels (shown in list_workspaces output).
LINEAR_LABEL_PERSONAL=Personal
LINEAR_LABEL_WORK=Work

# Single-workspace shortcut: if you only use one workspace, set just
# LINEAR_PAT (no _ALIAS suffix) and skip LINEAR_WORKSPACES.
# LINEAR_PAT=lin_api_REPLACE_ME
